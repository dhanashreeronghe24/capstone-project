generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Enums

enum BookFormat {
  PAPERBACK
  HARDCOVER
  EBOOK
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  UPI
  WALLET
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RefundStatus {
  INITIATED
  PROCESSED
  FAILED
}

enum ZoneCode {
  LOCAL
  REGIONAL
  NATIONAL
  METRO
}

enum ShippingTier {
  STANDARD
  EXPRESS
}

enum ShippingStatus {
  MANIFESTED
  IN_TRANSIT
  DELIVERED
}

// ------------------------------------------------- Member & Identity

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  phoneNumber  String?  @map("phone_number") @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  rewardPoints Int      @default(0) @map("reward_points")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  roles         UserRole[]
  addresses     Address[]
  refreshTokens RefreshToken[]
  reviews       Review[]
  cart          Cart?
  wishlistItems WishlistItem[]
  orders        Order[]

  @@map("users")
}

model Role {
  id          BigInt     @id @default(autoincrement())
  name        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId BigInt @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Supports refresh-token rotation and logout (only a hash of the token is stored).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  recipientName String   @map("recipient_name") @db.VarChar(150)
  phoneNumber   String   @map("phone_number") @db.VarChar(20)
  addressLine1  String   @map("address_line1") @db.VarChar(255)
  addressLine2  String?  @map("address_line2") @db.VarChar(255)
  city          String   @db.VarChar(100)
  state         String   @db.VarChar(100)
  postalCode    String   @map("postal_code") @db.VarChar(20)
  country       String   @default("India") @db.VarChar(100)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postalCode], map: "idx_addresses_pincode")
  @@map("addresses")
}

// ------------------------------------------------------------ Catalog

model Category {
  id           BigInt         @id @default(autoincrement())
  name         String         @unique @db.VarChar(100)
  slug         String         @unique @db.VarChar(120)
  parentId     BigInt?        @map("parent_id")
  displayOrder Int            @default(0) @map("display_order")
  isActive     Boolean        @default(true) @map("is_active")
  parent       Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]     @relation("CategoryTree")
  books        BookCategory[]

  @@map("categories")
}

model Author {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  bio       String?
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  books     Book[]

  @@index([name], map: "idx_authors_name")
  @@map("authors")
}

model Publisher {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(150)
  description String?
  books       Book[]

  @@map("publishers")
}

model Book {
  id               String     @id @default(uuid()) @db.Uuid
  title            String     @db.VarChar(255)
  subtitle         String?    @db.VarChar(255)
  isbn             String     @unique @db.VarChar(20)
  authorId         String     @map("author_id") @db.Uuid
  publisherId      String?    @map("publisher_id") @db.Uuid
  format           BookFormat
  language         String     @default("English") @db.VarChar(50)
  description      String?
  frontCoverUrl    String     @map("front_cover_url") @db.VarChar(500)
  backCoverUrl     String?    @map("back_cover_url") @db.VarChar(500)
  price            Decimal    @db.Decimal(10, 2)
  listPrice        Decimal?   @map("list_price") @db.Decimal(10, 2)
  stockQuantity    Int        @default(0) @map("stock_quantity")
  totalSalesCount  Int        @default(0) @map("total_sales_count")
  averageRating    Decimal    @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount      Int        @default(0) @map("review_count")
  isFeatured       Boolean    @default(false) @map("is_featured")
  isBestseller     Boolean    @default(false) @map("is_bestseller")
  isNewLaunch      Boolean    @default(false) @map("is_new_launch")
  publicationDate  DateTime?  @map("publication_date") @db.Date
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  author        Author         @relation(fields: [authorId], references: [id])
  publisher     Publisher?     @relation(fields: [publisherId], references: [id])
  categories    BookCategory[]
  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([title], map: "idx_books_title")
  @@index([authorId])
  @@index([totalSalesCount])
  @@map("books")
}

model BookCategory {
  bookId     String   @map("book_id") @db.Uuid
  categoryId BigInt   @map("category_id")
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([bookId, categoryId])
  @@map("book_categories")
}

model Review {
  id                 String   @id @default(uuid()) @db.Uuid
  bookId             String   @map("book_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  rating             Int      @db.SmallInt
  reviewerName       String   @map("reviewer_name") @db.VarChar(150)
  comment            String?
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  book               Book     @relation(fields: [bookId], references: [id])
  user               User     @relation(fields: [userId], references: [id])

  @@unique([bookId, userId])
  @@index([bookId])
  @@index([userId])
  @@map("reviews")
}

// ------------------------------------------------------ Cart & Wishlist

model Cart {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String?    @unique @map("user_id") @db.Uuid
  sessionToken String?    @unique @map("session_token") @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  user         User?      @relation(fields: [userId], references: [id])
  items        CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id])

  @@unique([cartId, bookId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("wishlists")
}

// ------------------------------------------------------------- Orders

model Coupon {
  id                BigInt       @id @default(autoincrement())
  code              String       @unique @db.VarChar(50)
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(10, 2)
  minOrderAmount    Decimal      @default(0) @map("min_order_amount") @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(10, 2)
  validFrom         DateTime     @map("valid_from") @db.Timestamptz
  validUntil        DateTime     @map("valid_until") @db.Timestamptz
  usageLimit        Int?         @map("usage_limit")
  timesUsed         Int          @default(0) @map("times_used")
  isActive          Boolean      @default(true) @map("is_active")

  @@map("coupons")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  orderNumber       String      @unique @map("order_number") @db.VarChar(32)
  userId            String?     @map("user_id") @db.Uuid
  guestEmail        String?     @map("guest_email") @db.VarChar(255)
  idempotencyKey    String?     @unique @map("idempotency_key") @db.VarChar(100)
  status            OrderStatus
  subtotalAmount    Decimal     @map("subtotal_amount") @db.Decimal(10, 2)
  taxAmount         Decimal     @default(0) @map("tax_amount") @db.Decimal(10, 2)
  shippingFee       Decimal     @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  discountAmount    Decimal     @default(0) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount       Decimal     @map("total_amount") @db.Decimal(10, 2)
  couponCode        String?     @map("coupon_code") @db.VarChar(50)
  pointsRedeemed    Int         @default(0) @map("points_redeemed")
  shippingAddress   Json        @map("shipping_address_json")
  estimatedDelivery DateTime    @map("estimated_delivery") @db.Date
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user     User?                @relation(fields: [userId], references: [id])
  items    OrderItem[]
  history  OrderStatusHistory[]
  payments PaymentTransaction[]
  refunds  Refund[]
  shipment Shipment?

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  bookId        String  @map("book_id") @db.Uuid
  bookTitle     String  @map("book_title") @db.VarChar(255)
  bookAuthor    String  @map("book_author") @db.VarChar(150)
  bookFormat    String  @map("book_format") @db.VarChar(50)
  coverImageUrl String  @map("cover_image_url") @db.VarChar(500)
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity      Int
  totalPrice    Decimal @map("total_price") @db.Decimal(10, 2)
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book          Book    @relation(fields: [bookId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id        BigInt      @id @default(autoincrement())
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  comments  String?     @db.VarChar(255)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// ----------------------------------------------------------- Payments

model PaymentTransaction {
  id                 String        @id @default(uuid()) @db.Uuid
  orderId            String        @map("order_id") @db.Uuid
  gatewayOrderId     String        @map("gateway_order_id") @db.VarChar(100)
  gatewayPaymentId   String?       @unique @map("gateway_payment_id") @db.VarChar(100)
  paymentMethod      PaymentMethod @map("payment_method")
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("INR") @db.VarChar(3)
  status             PaymentStatus
  gatewayResponseRaw Json?         @map("gateway_response_raw")
  errorMessage       String?       @map("error_message") @db.VarChar(255)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  order              Order         @relation(fields: [orderId], references: [id])
  refunds            Refund[]

  @@index([orderId])
  @@index([gatewayOrderId])
  @@map("payment_transactions")
}

model Refund {
  id              String            @id @default(uuid()) @db.Uuid
  paymentId       String            @map("payment_id") @db.Uuid
  orderId         String            @map("order_id") @db.Uuid
  refundAmount    Decimal           @map("refund_amount") @db.Decimal(10, 2)
  gatewayRefundId String?           @unique @map("gateway_refund_id") @db.VarChar(100)
  reason          String            @db.VarChar(255)
  status          RefundStatus
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  payment         PaymentTransaction @relation(fields: [paymentId], references: [id])
  order           Order             @relation(fields: [orderId], references: [id])

  @@map("refunds")
}

// ----------------------------------------------------------- Shipping

model PincodeZone {
  id              BigInt   @id @default(autoincrement())
  postalPincode   String   @unique @map("postal_pincode") @db.VarChar(10)
  city            String   @db.VarChar(100)
  state           String   @db.VarChar(100)
  zoneCode        ZoneCode @map("zone_code")
  standardEddDays Int      @default(4) @map("standard_edd_days")
  expressEddDays  Int      @default(1) @map("express_edd_days")
  isServicable    Boolean  @default(true) @map("is_servicable")

  @@map("pincode_zones")
}

model ShippingRate {
  id                    BigInt       @id @default(autoincrement())
  zoneCode              ZoneCode     @map("zone_code")
  shippingTier          ShippingTier @map("shipping_tier")
  baseRate              Decimal      @map("base_rate") @db.Decimal(10, 2)
  freeShippingThreshold Decimal      @default(499) @map("free_shipping_threshold") @db.Decimal(10, 2)
  perKgRate             Decimal      @default(0) @map("per_kg_rate") @db.Decimal(10, 2)

  @@unique([zoneCode, shippingTier])
  @@map("shipping_rates")
}

model Shipment {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @unique @map("order_id") @db.Uuid
  carrierName       String         @map("carrier_name") @db.VarChar(100)
  trackingNumber    String         @unique @map("tracking_number") @db.VarChar(100)
  shippingStatus    ShippingStatus @map("shipping_status")
  dispatchedAt      DateTime?      @map("dispatched_at") @db.Timestamptz
  estimatedDelivery DateTime       @map("estimated_delivery") @db.Date
  deliveredAt       DateTime?      @map("delivered_at") @db.Timestamptz
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  order             Order          @relation(fields: [orderId], references: [id])

  @@map("shipments")
}
